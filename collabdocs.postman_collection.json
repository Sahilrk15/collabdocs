{
  "info": {
    "name": "CollabDocs API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders top to bottom (Users -> Workspaces -> Documents -> Comments -> Tags -> Audit Logs). Ids are saved automatically by the test scripts."
  },
