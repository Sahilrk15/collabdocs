              ],
              "path": [
                "api",
                "users",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Asha\",\n  \"last_name\": \"Rao\",\n  \"email\": \"asha{{$timestamp}}@example.com\",\n  \"phone\": \"{{phone_a}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"phone_a\", \"9\" + String(Math.floor(Math.random()*1e9)).padStart(9,\"0\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
